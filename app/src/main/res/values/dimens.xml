<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  尺寸令牌（v2.0 · 对齐面板端 tokens.css）
  ============================================================
  尺度取 4dp 网格，组件高度与圆角对齐参考稿：

    页面留白 16 / 卡片内边距 14 / 卡片间距 10 / 卡片圆角 14
    应用栏 48 / 底部导航 56 / 按钮 44 / 输入框 44 / 可点区 ≥48
    圆角 6（小徽标）/ 10（输入·按钮）/ 14（卡片）/ 18（Hero）/ 24（Sheet）

  布局里不再出现 12dp、16dp 这类裸值；要新尺寸就先在这里加令牌。
  ============================================================
-->
<resources>

    <!-- ===== 间距（4dp 网格） ===== -->
    <dimen name="sp_1">4dp</dimen>
    <dimen name="sp_2">8dp</dimen>
    <dimen name="sp_3">12dp</dimen>
    <dimen name="sp_4">16dp</dimen>
    <dimen name="sp_7">32dp</dimen>

    <!-- 兼容旧名（v0.x 布局与弹窗仍在用，值对齐新网格） -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>

    <!-- ===== 页面骨架 =====
         手机 16dp 左右留白（参考稿的值）：360dp 屏上有效宽度 328dp，
         放得下双列小卡，又不会让卡片贴边。平板/大屏各档覆写。 -->
    <dimen name="page_padding_horizontal">16dp</dimen>
    <dimen name="page_padding_top">4dp</dimen>
    <dimen name="page_padding_bottom">24dp</dimen>

    <!-- 应用栏（48dp）：标题 20sp + 副标题 11sp 上下叠放，右侧 34dp 图标钮 -->
    <dimen name="appbar_height">48dp</dimen>
    <dimen name="appbar_icon_button">34dp</dimen>

    <!-- 底部导航 56dp -->
    <dimen name="tabbar_icon">18dp</dimen>
    <dimen name="nav_divider_height">1dp</dimen>

    <!-- ===== 卡片 ===== -->
    <dimen name="card_padding">14dp</dimen>
    <dimen name="card_padding_hero">18dp</dimen>
    <dimen name="card_radius">14dp</dimen>
    <dimen name="card_radius_hero">18dp</dimen>
    <dimen name="card_gap">10dp</dimen>
    <!-- 旧名兼容 -->

    <!-- ===== 圆角 ===== -->
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_s">10dp</dimen>
    <dimen name="radius_m">14dp</dimen>
    <dimen name="radius_l">18dp</dimen>
    <dimen name="radius_xl">24dp</dimen>
    <dimen name="radius_full">999dp</dimen>

    <!-- ===== 触控与控件高度 ===== -->
    <!-- Android 无障碍基线 48dp；视觉高度可以更小，但可点区域不能 -->
    <dimen name="touch_min">48dp</dimen>
    <dimen name="btn_height">44dp</dimen>
    <dimen name="btn_height_sm">32dp</dimen>
    <dimen name="icon_size">24dp</dimen>
    <dimen name="icon_size_small">20dp</dimen>
    <dimen name="icon_tile">32dp</dimen>
    <dimen name="icon_tile_radius">9dp</dimen>
    <dimen name="list_row_min_height">52dp</dimen>
    <dimen name="list_row_padding_vertical">10dp</dimen>

    <!-- ===== 头像（38dp 圆角方形，不是圆形：参考稿用的 squircle 更像产品） ===== -->
    <dimen name="avatar_size">38dp</dimen>
    <dimen name="avatar_radius">12dp</dimen>

    <!-- ===== 状态 pill（23dp 高，11.5sp 字） ===== -->
    <dimen name="pill_height">23dp</dimen>
    <dimen name="pill_height_sm">20dp</dimen>
    <dimen name="pill_padding_horizontal">9dp</dimen>
    <dimen name="pill_gap">5dp</dimen>
    <!-- 旧 chip 名兼容 -->

    <!-- ===== 数据可视化 ===== -->
    <dimen name="ring_size">88dp</dimen>
    <dimen name="ring_thickness">8dp</dimen>

    <!-- ===== 日志控制台 ===== -->
    <dimen name="log_window_height">200dp</dimen>
    <dimen name="crawl_log_window_height">190dp</dimen>
    <dimen name="topic_list_height">320dp</dimen>

    <!-- ===== 图库网格 ===== -->
    <dimen name="gallery_cell_min_height">96dp</dimen>
    <dimen name="gallery_gutter">4dp</dimen>
    <dimen name="gallery_cell_radius">12dp</dimen>
    <dimen name="gallery_gif_badge_padding_horizontal">4dp</dimen>
    <dimen name="gallery_gif_badge_padding_vertical">1dp</dimen>

    <!-- ===== 超话页（v0.9.0） ===== -->
    <!-- 等级徽章：18dp 高 / 最小 30dp 宽，能放下 "Lv.12" 又不喧哗 -->
    <dimen name="topic_badge_height">18dp</dimen>
    <dimen name="topic_badge_min_width">30dp</dimen>
    <dimen name="topic_selector_height">38dp</dimen>
    <dimen name="topic_filter_bar_height">44dp</dimen>
    <dimen name="progress_thickness">6dp</dimen>

    <!-- ===== 图库浏览增强（v0.9.0） ===== -->
    <dimen name="gallery_filter_bar_height">40dp</dimen>
    <dimen name="gallery_search_height">44dp</dimen>
    <dimen name="gallery_group_header_height">30dp</dimen>
    <dimen name="gallery_select_bar_height">56dp</dimen>
    <dimen name="gallery_check_size">20dp</dimen>

    <!-- 列表分隔线缩进 -->
</resources>
