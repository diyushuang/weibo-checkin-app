<?xml version="1.0" encoding="utf-8"?>
<!--
  浏览列表卡片（v0.9.11，v0.9.17 改小图）：元信息行 + 正文摘要 + 一排小图。

  v0.9.17：图从「撑满整行 / 三等分正方形 / CENTER_CROP」改成 56dp 小图、
  FIT_CENTER 整张缩进去。原因：卡片只有一屏宽，三等分的正方形逼着图片裁切，
  宽图在列表里只剩一条色带，用户根本看不出画面。现在小图负责「看得出是什么」，
  点开 [RemotePreviewActivity] 才看大图；点卡片仍是进选图页。

  小图由 BrowsingActivity 按数量动态填充 ImageView（列数按可用宽度算，
  手机 5 列、平板更多），这里只放容器；超出 9 张显示「+n」格，进选图页看全量。

  多选态：整卡左侧品牌竖条 + 半透明遮罩由代码在 card 上叠 scrim 实现 ——
  勾选语义是「整帖全抓」，视觉上用遮罩 + 计数即可，不再逐格打勾。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browseCard"
    style="@style/Widget.Wcm.Card.Clickable"
    app:cardCornerRadius="@dimen/card_radius">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            style="@style/Widget.Wcm.CardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 元信息：时间 · 置顶/转发/图数 -->
            <TextView
                android:id="@+id/tvBrowseMeta"
                style="@style/Widget.Wcm.Text.Hint.SingleLine" />

            <TextView
                android:id="@+id/tvBrowseText"
                style="@style/Widget.Wcm.Text.Body"
                android:layout_marginTop="@dimen/sp_1"
                android:maxLines="4"
                android:ellipsize="end" />

            <!-- 小图容器：列数由代码按可用宽度设置（手机 5 列），代码填充 -->
            <GridLayout
                android:id="@+id/browsePics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_2"
                android:columnCount="5" />
        </LinearLayout>

        <!-- 选中遮罩：多选模式下盖整卡（必须在外层 FrameLayout，
             放进纵向 LinearLayout 里只会是 1dp 线，盖不住内容） -->
        <View
            android:id="@+id/browseScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_selected_scrim"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- 选中标记：右上角圆点对勾（多选模式） -->
        <ImageView
            android:id="@+id/browseCheck"
            android:layout_width="@dimen/gallery_check_size"
            android:layout_height="@dimen/gallery_check_size"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/sp_2"
            android:background="@drawable/bg_cell_check"
            android:contentDescription="@string/gallery_cd_check"
            android:padding="3dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/brand_on" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
