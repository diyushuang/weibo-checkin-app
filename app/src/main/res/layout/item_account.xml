<?xml version="1.0" encoding="utf-8"?>
<!--
  账号行（v2.0）。

  一行三段的密排结构（对齐参考稿的账号卡）：

    头像 38dp squircle  |  昵称 13.5sp + 状态 pill  |  ⋮
                        |  副行：状态说明 11.5sp（UID 与结果合并成一句）
    行底 1dp 发丝线由 foreground 画，水波纹留在 background。

  为什么不再给 UID 单独一行：多账号列表里 UID 是"查证用"的低频信息，
  合并进副行后每行矮了 16dp，一屏能多看到一个账号 —— 密排换来的信息量更大。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Wcm.ListRow"
    android:paddingTop="@dimen/sp_3"
    android:paddingBottom="@dimen/sp_3"
    android:foreground="@drawable/fg_row_divider">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAvatar"
        style="@style/Widget.Wcm.Avatar"
        app:autoSizeMaxTextSize="14sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeTextType="uniform" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sp_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 昵称 + 状态 pill 同一行：名字右肩就是结论，扫读不用换行找 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                style="@style/Widget.Wcm.Text.RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chipLevel"
                    style="@style/Widget.Wcm.Pill.Neutral"
                    android:layout_height="@dimen/pill_height_sm"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipDone"
                    style="@style/Widget.Wcm.Pill.Ok.Small"
                    android:layout_marginStart="@dimen/pill_gap" />

                <TextView
                    android:id="@+id/chipPending"
                    style="@style/Widget.Wcm.Pill.Warn.Small"
                    android:layout_marginStart="@dimen/pill_gap" />
            </LinearLayout>
        </LinearLayout>

        <!-- UID：低频查证信息，压在副行 -->
        <TextView
            android:id="@+id/tvUid"
            style="@style/Widget.Wcm.Text.Hint"
            android:layout_marginTop="2dp" />

        <!-- 签到结果 / 超话状态说明 -->
        <TextView
            android:id="@+id/tvStatus"
            style="@style/Widget.Wcm.Text.Hint"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAccountMore"
        style="@style/Widget.Wcm.IconButton.Row"
        android:contentDescription="@string/account_more"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/ink_3" />
</LinearLayout>
