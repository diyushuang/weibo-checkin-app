<?xml version="1.0" encoding="utf-8"?>
<!--
  远程大图预览（v0.9.17）：浏览页点小图后的全屏查看。

  只有两样东西：ViewPager2 装 ZoomableImageView（左右翻、双指缩放），
  和顶部一颗「第几张 / 共几张」的计数胶囊。背景恒为纯黑，颜色令牌都用
  on_preview_* 系列（与本地图库的预览页同一套，纯黑上才够对比度）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remotePreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/remotePreviewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvRemotePreviewIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/space_l"
        android:background="@color/preview_bar_scrim"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/on_preview_surface" />

    <!-- 大图是 2MB+ 的一次性请求，等的时候不能只有一块黑屏 -->
    <ProgressBar
        android:id="@+id/remotePreviewLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/on_preview_surface" />
</FrameLayout>
