<?xml version="1.0" encoding="utf-8"?>
<!--
  超话页（v0.9.0）。

  结构：应用栏（固定） → 账号选择器 → Hero 概览 → 筛选/排序条 → 列表（滚动）。

  顶部四块固定不动，是因为这一页的核心问题是「今天还有几个没签」——
  概览与筛选必须一直在视野里，滚走反而要多一步找回来。
  列表本体交给 RecyclerView，关注上百个超话时也只测量可见行。
-->
<!-- 不给根布局上底色：窗口背景（theme 的 windowBackground）已经是同一个颜色，
     再画一遍只是纯粹的 overdraw（多一层全屏填充）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingEnd="@dimen/page_padding_horizontal">

        <!-- ==================== 应用栏 ==================== -->
        <LinearLayout style="@style/Widget.Wcm.AppBar">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTopicTitle"
                    style="@style/Widget.Wcm.Text.Display"
                    android:text="@string/topic_title" />

                <TextView
                    android:id="@+id/tvTopicSubtitle"
                    style="@style/Widget.Wcm.Text.Hint"
                    android:layout_marginTop="1dp"
                    android:text="@string/topic_subtitle_idle" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnTopicRefresh"
                style="@style/Widget.Wcm.IconButton"
                android:contentDescription="@string/btn_refresh_topics"
                android:src="@drawable/ic_refresh"
                app:tint="@color/ink_2" />

            <ImageButton
                android:id="@+id/btnTopicMore"
                style="@style/Widget.Wcm.IconButton.Plain"
                android:layout_marginStart="@dimen/sp_1"
                android:contentDescription="@string/cd_topic_more"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/ink_3" />
        </LinearLayout>

        <!-- ==================== 账号选择器 ==================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/topic_selector_height"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/topicAccountPills"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ==================== Hero：三个结论数字 ==================== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Wcm.Card.Hero"
            android:layout_marginTop="@dimen/sp_1">

            <LinearLayout
                style="@style/Widget.Wcm.CardContent.Hero"
                android:orientation="vertical">

                <!-- 三列统计：每列是「10.5sp 键名 + 19sp 数字」的纵向块，基线对齐无意义 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Wcm.Text.Cap"
                            android:text="@string/topic_metric_total" />

                        <TextView
                            android:id="@+id/tvMetricTotal"
                            style="@style/Widget.Wcm.Text.Metric"
                            android:layout_marginTop="1dp"
                            android:text="@string/topic_metric_empty" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Wcm.Text.Cap"
                            android:text="@string/topic_metric_done" />

                        <TextView
                            android:id="@+id/tvMetricDone"
                            style="@style/Widget.Wcm.Text.Metric"
                            android:layout_marginTop="1dp"
                            android:text="@string/topic_metric_empty" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Wcm.Text.Cap"
                            android:text="@string/topic_metric_pending" />

                        <TextView
                            android:id="@+id/tvMetricPending"
                            style="@style/Widget.Wcm.Text.Metric"
                            android:layout_marginTop="1dp"
                            android:text="@string/topic_metric_empty" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/prTopic"
                    style="@style/Widget.Wcm.Progress"
                    android:layout_marginTop="@dimen/sp_3"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tvTopicStatus"
                    style="@style/Widget.Wcm.Text.Hint.SingleLine"
                    android:layout_marginTop="@dimen/sp_2"
                    android:text="@string/topic_subtitle_idle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== 筛选 / 排序 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/topic_filter_bar_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/topicFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btnTopicSort"
                style="@style/Widget.Wcm.IconButton.Row"
                android:contentDescription="@string/topic_sort_label"
                android:src="@drawable/ic_sort"
                app:tint="@color/ink_2" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 列表 / 空态 / 错误态 ==================== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/topicList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_padding_horizontal"
            android:paddingEnd="@dimen/page_padding_horizontal"
            android:paddingBottom="@dimen/sp_4"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/topicEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/sp_7"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTopicEmpty"
                style="@style/Widget.Wcm.Text.Empty"
                android:gravity="center"
                android:text="@string/topic_empty_no_topic" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTopicEmptyAction"
                style="@style/Widget.Wcm.Button.Secondary.Small"
                android:layout_marginTop="@dimen/sp_2"
                android:text="@string/topic_go_home"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/topicError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/sp_7"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTopicError"
                style="@style/Widget.Wcm.Text.Empty"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTopicRetry"
                style="@style/Widget.Wcm.Button.Secondary.Small"
                android:layout_marginTop="@dimen/sp_2"
                android:text="@string/topic_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
